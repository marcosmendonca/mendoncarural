---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { coefficientCategories } from '../../data/site';
---
<BaseLayout title="Coeficientes técnicos | Mendonça Consultoria Rural"><section class="page-hero"><div class="container"><span class="eyebrow">Biblioteca técnica</span><h1>Coeficientes técnicos</h1><p>Conteúdo organizado por atividade produtiva, com estrutura preparada para consulta e download.</p></div></section><section class="section"><div class="container grid cards-3">{coefficientCategories.map(c=><a class="card" href={`/coeficientes/${c.slug}`}><h3>{c.title}</h3><p>{c.items.join(' • ')}</p><strong>Acessar categoria →</strong></a>)}</div></section></BaseLayout>
