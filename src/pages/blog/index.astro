---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
const posts=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf());
const categories=[...new Set(posts.map((post)=>post.data.category))];
---
<BaseLayout title="Blog técnico rural | Mendonça Consultoria Rural" description="Conteúdo técnico sobre crédito rural, regularização ambiental e fundiária, projetos agropecuários e georreferenciamento.">
<section class="border-b border-slate-200 bg-[linear-gradient(180deg,#f7faf8_0%,#fff_100%)]"><div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28"><span class="text-xs font-black uppercase tracking-[.18em] text-emerald-800">Conteúdo técnico</span><h1 class="mt-5 max-w-4xl text-4xl font-black leading-[1.04] tracking-[-.045em] text-slate-950 sm:text-5xl lg:text-7xl">Informação clara para decisões mais seguras no campo.</h1><p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600">Crédito rural, regularização, projetos agropecuários, georreferenciamento e documentação rural explicados de forma prática.</p>{categories.length>0&&<div class="mt-8 flex flex-wrap gap-2">{categories.map((category)=><span class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-bold text-slate-600">{category}</span>)}</div>}</div></section>
<section class="mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-24">{posts.length===0?<div class="border-y border-slate-200 py-14"><h2 class="text-3xl font-black tracking-[-.035em] text-slate-950">Os primeiros artigos estão sendo preparados.</h2><p class="mt-4 max-w-2xl leading-7 text-slate-600">Em breve esta biblioteca reunirá orientações técnicas relacionadas às principais demandas atendidas pela consultoria.</p></div>:<div class="divide-y divide-slate-200 border-y border-slate-200">{posts.map((post)=>{const slug=post.id.replace(/\.(md|mdx)$/,'');return <article class="grid gap-5 py-8 md:grid-cols-[180px_1fr_auto] md:items-start"><div><span class="text-xs font-black uppercase tracking-[.12em] text-emerald-800">{post.data.category}</span><time class="mt-2 block text-xs text-slate-500">{post.data.publishedAt.toLocaleDateString('pt-BR')}</time></div><div><h2 class="text-2xl font-black tracking-[-.025em] text-slate-950"><a class="hover:text-emerald-800" href={`/blog/${slug}/`}>{post.data.title}</a></h2><p class="mt-3 max-w-3xl leading-7 text-slate-600">{post.data.description}</p></div><a href={`/blog/${slug}/`} class="font-bold text-emerald-800">Ler →</a></article>})}</div>}</section><ContactCTA title="Precisa de orientação para uma demanda específica?"/>
</BaseLayout>
