---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { blogPosts } from '../../data/site';
---
<BaseLayout title="Blog técnico rural | Mendonça Consultoria Rural" description="Conteúdo técnico sobre crédito rural, regularização, produção e gestão da propriedade rural.">
<section class="border-b border-slate-200 bg-[linear-gradient(180deg,#f7faf8_0%,#fff_100%)]"><div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28"><span class="text-xs font-black uppercase tracking-[.18em] text-emerald-800">Conteúdo técnico</span><h1 class="mt-5 max-w-4xl text-4xl font-black leading-[1.04] tracking-[-.045em] text-slate-950 sm:text-5xl lg:text-7xl">Informação clara para decisões mais seguras no campo.</h1><p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600">Conteúdos sobre crédito rural, regularização, produção agropecuária, documentação e gestão da propriedade.</p></div></section>
<section class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28"><div class="grid gap-x-8 gap-y-14 md:grid-cols-2 lg:grid-cols-3">{blogPosts.map((post,index)=><article class:list={['group',index===0&&'md:col-span-2 lg:col-span-2']}><div class:list={['relative overflow-hidden rounded-2xl bg-slate-100',index===0?'aspect-[16/8]':'aspect-[16/10]']}><img src={`/images/blog/${post.slug}.webp`} alt="" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]" loading="lazy" onerror="this.style.display='none'"/><div class="absolute inset-0 bg-[linear-gradient(145deg,#edf4f0_0%,#dcebe3_50%,#c8ddd2_100%)] -z-10"></div></div><div class="pt-6"><span class="text-xs font-black uppercase tracking-[.14em] text-emerald-800">{post.category}</span><h2 class:list={['mt-3 font-black tracking-[-.025em] text-slate-950',index===0?'text-3xl':'text-2xl']}>{post.title}</h2><p class="mt-3 leading-7 text-slate-600">{post.excerpt}</p><div class="mt-5 text-sm text-slate-500"><time>{post.date}</time></div></div></article>)}</div></section>
<ContactCTA title="Precisa de orientação para uma demanda específica?"/>
</BaseLayout>
