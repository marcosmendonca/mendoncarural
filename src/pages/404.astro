---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
title="Página não encontrada"
description="A página que você procura não existe."
>

<section class="mx-auto max-w-4xl px-5 py-32 text-center">

<span class="text-sm font-black uppercase tracking-[.18em] text-[#1E4D3A]">

Erro 404

</span>

<h1 class="mt-6 text-6xl font-black tracking-[-.05em] text-slate-950">

Página não encontrada

</h1>

<p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-slate-600">

A página que você tentou acessar não existe ou foi movida.

</p>

<a
href="/"
class="mt-10 inline-flex rounded-xl bg-[#1E4D3A] px-6 py-4 font-bold text-white"
>

Voltar para a página inicial

</a>

</section>

</BaseLayout>
