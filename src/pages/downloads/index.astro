---
import BaseLayout from '../../layouts/BaseLayout.astro';
const materials=['Guia de documentos para crédito rural','Checklist de regularização da propriedade','E-book de planejamento da atividade rural','Guia básico de análise de solo','Planilha de organização de custos'];
---
<BaseLayout title="Downloads | Mendonça Consultoria Rural" noindex={true}><section class="page-hero"><div class="container"><span class="eyebrow">Materiais gratuitos</span><h1>E-books, guias e downloads</h1><p>Área destinada a materiais educativos, checklists, planilhas e publicações técnicas.</p></div></section><section class="section"><div class="container grid cards-3">{materials.map(m=><div class="card"><span class="tag">Material</span><h3>{m}</h3><p>Arquivo reservado para publicação futura.</p><button class="btn btn-secondary" disabled>Em preparação</button></div>)}</div></section></BaseLayout>
