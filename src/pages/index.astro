---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAIcon from '../components/FAIcon.astro';
import { site, services, solutionPaths } from '../data/site';
---
<BaseLayout title="Mendonça Consultoria Rural | Soluções técnicas para o campo" description={site.description}>
<section class="overflow-hidden border-b border-slate-200 bg-[linear-gradient(180deg,#f7faf8_0%,#fff_100%)]"><div class="mx-auto grid max-w-7xl gap-14 px-5 py-20 lg:grid-cols-[1.1fr_.9fr] lg:items-center lg:px-8 lg:py-28"><div><span class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-[.18em] text-emerald-800"><span class="h-px w-8 bg-emerald-700"></span>Consultoria agronômica</span><h1 class="mt-6 max-w-4xl text-4xl font-black leading-[1.02] tracking-[-.05em] text-slate-950 sm:text-5xl lg:text-7xl">Soluções técnicas para financiar, regularizar e desenvolver sua propriedade rural.</h1><p class="mt-7 max-w-3xl text-lg leading-8 text-slate-600 lg:text-xl">Crédito rural, regularização ambiental e fundiária, projetos agropecuários e levantamentos técnicos com atendimento estruturado e linguagem clara.</p><div class="mt-9 flex flex-col gap-3 sm:flex-row"><a href="/solucoes" class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-900 px-5 py-3.5 text-sm font-bold text-white transition hover:bg-emerald-800">Encontrar uma solução <FAIcon name="arrow-right" class="h-3.5 w-3.5" /></a><a href="/orcamento" class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3.5 text-sm font-bold text-slate-800 transition hover:border-emerald-700 hover:text-emerald-800">Solicitar atendimento</a></div><div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 border-t border-slate-200 pt-6 text-xs font-bold uppercase tracking-[.1em] text-slate-500"><span>Atendimento nacional</span><span>Escopo definido</span><span>ART quando aplicável</span></div></div><div class="relative min-h-[460px] overflow-hidden rounded-[2rem] border border-slate-200 bg-[linear-gradient(145deg,#e4efe9_0%,#c7ddd2_42%,#0f4939_43%,#082b22_100%)] shadow-2xl shadow-slate-900/10"><img src="/images/hero/hero-agriculture.webp" alt="Propriedade rural e produção agropecuária" class="absolute inset-0 h-full w-full object-cover" onerror="this.style.display='none'"/><div class="absolute inset-0 bg-gradient-to-t from-slate-950/55 via-transparent to-transparent"></div><div class="absolute bottom-8 left-8 right-8 max-w-sm text-white"><span class="text-[10px] font-black uppercase tracking-[.18em] text-emerald-200">Mendonça Consultoria Rural</span><strong class="mt-2 block text-xl leading-snug">Engenharia agronômica aplicada às decisões do campo.</strong></div></div></div></section>
<section class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28"><div class="grid gap-14 lg:grid-cols-[.68fr_1.32fr]"><div class="lg:sticky lg:top-28 lg:self-start"><span class="text-xs font-black uppercase tracking-[.18em] text-emerald-800">Como podemos ajudar?</span><h2 class="mt-4 text-3xl font-black tracking-[-.035em] text-slate-950 lg:text-5xl">Comece pelo que você precisa resolver.</h2><p class="mt-5 leading-7 text-slate-600">Navegue pela sua necessidade, mesmo sem conhecer o nome técnico do serviço.</p></div><div class="divide-y divide-slate-200 border-y border-slate-200">{solutionPaths.map((item)=><a href={item.href} class="group grid gap-4 py-6 sm:grid-cols-[48px_1fr_auto] sm:items-center"><span class="grid h-10 w-10 place-items-center rounded-xl bg-emerald-50 text-emerald-800"><FAIcon name={item.icon} class="h-4 w-4" /></span><span><strong class="block text-lg text-slate-950 group-hover:text-emerald-800">{item.title}</strong><small class="mt-1 block text-sm leading-6 text-slate-500">{item.description}</small></span><FAIcon name="arrow-right" class="hidden h-4 w-4 text-slate-400 transition group-hover:translate-x-1 group-hover:text-emerald-800 sm:block" /></a>)}</div></div></section>
<section class="bg-slate-950 text-white"><div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28"><div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end"><div class="max-w-3xl"><span class="text-xs font-black uppercase tracking-[.18em] text-emerald-400">Áreas de atuação</span><h2 class="mt-4 text-3xl font-black tracking-[-.035em] lg:text-5xl">Consultoria organizada por especialidade.</h2></div><a href="/solucoes" class="inline-flex items-center gap-2 text-sm font-bold text-emerald-400">Ver todas as soluções <FAIcon name="arrow-right" class="h-3.5 w-3.5" /></a></div><div class="mt-12 divide-y divide-white/15 border-y border-white/15">{services.map((service,index)=><a href={`/solucoes/${service.slug}`} class="group grid gap-5 py-7 lg:grid-cols-[60px_1fr_1fr_auto] lg:items-center"><span class="text-xs font-black text-emerald-400">{String(index+1).padStart(2,'0')}</span><strong class="text-xl lg:text-2xl">{service.title}</strong><span class="text-sm leading-6 text-slate-400">{service.text}</span><FAIcon name="arrow-right" class="h-4 w-4 text-emerald-400 transition group-hover:translate-x-1" /></a>)}</div></div></section>
<section class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28"><div class="grid gap-12 lg:grid-cols-[.8fr_1.2fr]"><div><span class="text-xs font-black uppercase tracking-[.18em] text-emerald-800">Atendimento</span><h2 class="mt-4 text-3xl font-black tracking-[-.035em] text-slate-950 lg:text-5xl">Processo simples, documentado e profissional.</h2><a href="/como-trabalhamos" class="mt-7 inline-flex items-center gap-2 text-sm font-bold text-emerald-800">Conhecer a metodologia <FAIcon name="arrow-right" class="h-3.5 w-3.5" /></a></div><ol class="divide-y divide-slate-200 border-y border-slate-200">{[['01','Conte sua necessidade'],['02','Envie as informações necessárias'],['03','Receba escopo e proposta'],['04','Acompanhe a execução'],['05','Receba a entrega técnica']].map(([n,t])=><li class="grid grid-cols-[50px_1fr] py-5"><span class="text-xs font-black text-emerald-800">{n}</span><strong class="text-lg text-slate-900">{t}</strong></li>)}</ol></div></section>
<section class="mx-auto max-w-7xl px-5 pb-20 lg:px-8 lg:pb-28"><div class="grid gap-8 rounded-[2rem] bg-emerald-950 px-8 py-10 text-white lg:grid-cols-[1fr_auto] lg:items-center lg:px-14 lg:py-14"><div><span class="text-xs font-black uppercase tracking-[.18em] text-emerald-300">Atendimento inicial</span><h2 class="mt-3 text-3xl font-black tracking-[-.035em]">Apresente sua necessidade.</h2><p class="mt-4 max-w-3xl text-emerald-50/75">Preencha as informações iniciais e continue o atendimento diretamente pelo WhatsApp.</p></div><a href="/orcamento" class="inline-flex items-center justify-center gap-2 rounded-xl bg-white px-5 py-3.5 text-sm font-bold text-emerald-950">Solicitar atendimento <FAIcon name="arrow-right" class="h-3.5 w-3.5" /></a></div></section>
</BaseLayout>
