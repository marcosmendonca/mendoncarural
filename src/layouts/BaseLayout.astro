---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { site } from '../data/site';
const { title = site.name, description = site.description, image = site.image, noindex = false, schema } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site || site.url);
const absoluteImage = new URL(image, Astro.site || site.url);
const organizationSchema = {
  '@context':'https://schema.org', '@type':'ProfessionalService', name:site.name, url:site.url,
  description:site.description, email:site.email, telephone:`+${site.phoneRaw}`,
  areaServed:{'@type':'Country',name:'Brasil'}
};
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>{title}</title>
  <meta name="description" content={description}/>
  <link rel="canonical" href={canonical}/>
  {noindex && <meta name="robots" content="noindex,nofollow"/>}
  <meta name="theme-color" content="#075842"/>
  <meta property="og:locale" content="pt_BR"/><meta property="og:site_name" content={site.name}/>
  <meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content={absoluteImage}/>
  <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={absoluteImage}/>
  <link rel="icon" href="/images/brand/favicon.svg" type="image/svg+xml"/>
  <script type="application/ld+json" set:html={JSON.stringify(schema || organizationSchema)}></script>
</head>
<body>
  <Header/>
  <main><slot/></main>
  <a class="whatsapp" href={`https://wa.me/${site.phoneRaw}?text=${encodeURIComponent('Olá! Gostaria de informações sobre os serviços técnicos.')}`} aria-label="Abrir WhatsApp" target="_blank" rel="noreferrer"><span>WhatsApp</span>↗</a>
  <Footer/>
</body>
</html>
