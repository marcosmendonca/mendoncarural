---
const { items=[] } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Navegação estrutural">
  <a href="/">Início</a>
  {items.map((item, index) => <><span aria-hidden="true">/</span>{item.href && index < items.length - 1 ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}</>)}
</nav>
