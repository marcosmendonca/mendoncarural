---
import { site, services } from '../data/site';
import FAIcon from './FAIcon.astro';
const current = Astro.url.pathname;
const mainLinks = [
  ['Soluções','/solucoes'],
  ['Como Trabalhamos','/como-trabalhamos'],
  ['Blog','/blog'],
  ['Sobre','/sobre'],
  ['Contato','/contato']
];
---
<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur-xl">
  <div class="mx-auto flex h-[76px] max-w-7xl items-center gap-8 px-5 lg:px-8">
    <a href="/" class="flex min-w-fit items-center gap-3" aria-label={`${site.name} — página inicial`}>
      <img src="/images/brand/LOGO%20MENDONCA%20RURAL.png" alt={site.name} class="h-11 w-auto object-contain" />
    </a>
    <nav class="hidden flex-1 items-center justify-center gap-1 lg:flex" aria-label="Navegação principal">
      <div class="group relative">
        <a href="/solucoes" class:list={["inline-flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold transition hover:bg-slate-50 hover:text-emerald-800", current.startsWith('/solucoes') ? 'text-emerald-800' : 'text-slate-600']}>Soluções <FAIcon name="chevron-down" class="h-3 w-3" /></a>
        <div class="invisible absolute left-1/2 top-full w-[620px] -translate-x-1/2 translate-y-2 rounded-2xl border border-slate-200 bg-white p-3 opacity-0 shadow-2xl shadow-slate-900/10 transition group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
          <div class="grid grid-cols-2 gap-1">{services.map((service) => (<a href={`/solucoes/${service.slug}`} class="group/item flex gap-3 rounded-xl p-4 transition hover:bg-emerald-50/70"><span class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-emerald-50 text-emerald-800"><FAIcon name={service.icon} class="h-4 w-4" /></span><span><strong class="block text-sm text-slate-900">{service.shortTitle}</strong><small class="mt-1 block leading-5 text-slate-500">{service.text}</small></span></a>))}</div>
        </div>
      </div>
      {mainLinks.slice(1).map(([label,url]) => <a class:list={["rounded-lg px-3 py-2 text-sm font-semibold transition hover:bg-slate-50 hover:text-emerald-800", current===url || current.startsWith(`${url}/`) ? 'text-emerald-800' : 'text-slate-600']} href={url}>{label}</a>)}
    </nav>
    <a class="hidden items-center gap-2 rounded-xl bg-emerald-900 px-4 py-3 text-sm font-bold text-white transition hover:bg-emerald-800 xl:inline-flex" href="/orcamento">Solicitar atendimento <FAIcon name="arrow-right" class="h-3.5 w-3.5" /></a>
    <button id="menu-trigger" class="ml-auto grid h-11 w-11 place-items-center rounded-xl border border-slate-200 text-slate-700 lg:hidden" aria-label="Abrir menu" aria-expanded="false"><FAIcon name="bars" class="h-5 w-5" /></button>
  </div>
  <div id="mobile-menu" class="hidden border-t border-slate-200 bg-white px-5 py-5 lg:hidden"><nav class="mx-auto grid max-w-7xl gap-1">{mainLinks.map(([label,url]) => <a href={url} class="rounded-lg px-3 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50">{label}</a>)}<div class="my-2 border-t border-slate-100"></div>{services.map((service)=><a href={`/solucoes/${service.slug}`} class="px-3 py-2 text-sm text-slate-500">{service.shortTitle}</a>)}<a href="/orcamento" class="mt-3 rounded-xl bg-emerald-900 px-4 py-3 text-center text-sm font-bold text-white">Solicitar atendimento</a></nav></div>
</header>
<script>
  const trigger = document.querySelector('#menu-trigger');
  const menu = document.querySelector('#mobile-menu');
  trigger?.addEventListener('click', () => { const open = trigger.getAttribute('aria-expanded') === 'true'; trigger.setAttribute('aria-expanded', String(!open)); menu?.classList.toggle('hidden', open); });
</script>
