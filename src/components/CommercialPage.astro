---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import FAIcon from './FAIcon.astro';
import { site } from '../data/site';
const { service } = Astro.props;
const whatsappText = encodeURIComponent(`Olá! Gostaria de conversar sobre ${service.shortTitle}.`);
const schema = {'@context':'https://schema.org','@type':'Service',name:service.title,description:service.text,provider:{'@type':'ProfessionalService',name:site.name,url:site.url},areaServed:{'@type':'Country',name:'Brasil'}};
---
<BaseLayout title={`${service.title} | ${site.name}`} description={service.text} schema={schema}>
<section class="border-b border-slate-200 bg-[linear-gradient(180deg,#f8fbf9_0%,#ffffff_100%)]"><div class="mx-auto max-w-7xl px-5 py-8 lg:px-8 lg:py-12"><Breadcrumbs items={[{label:'Soluções',href:'/solucoes'},{label:service.shortTitle}]} /><div class="grid items-end gap-12 py-8 lg:grid-cols-[1.15fr_.85fr] lg:py-14"><div><span class="mb-5 inline-flex items-center gap-2 text-xs font-black uppercase tracking-[.18em] text-emerald-800"><span class="h-px w-8 bg-emerald-700"></span>{service.eyebrow}</span><h1 class="max-w-4xl text-4xl font-black leading-[1.03] tracking-[-.045em] text-slate-950 sm:text-5xl lg:text-7xl">{service.title}</h1><p class="mt-7 max-w-3xl text-lg leading-8 text-slate-600 lg:text-xl">{service.text}</p><div class="mt-9 flex flex-col gap-3 sm:flex-row"><a href={`/orcamento?servico=${service.slug}`} class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-900 px-5 py-3.5 text-sm font-bold text-white transition hover:bg-emerald-800">Solicitar análise inicial <FAIcon name="arrow-right" class="h-3.5 w-3.5" /></a><a href={`https://wa.me/${site.phoneRaw}?text=${whatsappText}`} target="_blank" rel="noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3.5 text-sm font-bold text-slate-800 transition hover:border-emerald-700 hover:text-emerald-800"><FAIcon name="whatsapp" class="h-4 w-4" /> Conversar no WhatsApp</a></div></div><aside class="border-l-2 border-emerald-800 pl-7 lg:mb-2"><span class="text-xs font-black uppercase tracking-[.16em] text-slate-400">Objetivo do trabalho</span><p class="mt-4 text-lg font-semibold leading-8 text-slate-800">{service.outcome}</p></aside></div></div></section>
<section class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28"><div class="grid gap-16 lg:grid-cols-[.72fr_1.28fr]"><div class="lg:sticky lg:top-28 lg:self-start"><span class="text-xs font-black uppercase tracking-[.18em] text-emerald-800">O que resolvemos</span><h2 class="mt-4 text-3xl font-black tracking-[-.035em] text-slate-950 lg:text-5xl">Serviços organizados pela sua necessidade.</h2><p class="mt-5 leading-7 text-slate-600">A contratação é definida após uma triagem técnica, considerando a finalidade, a documentação disponível e os limites profissionais de cada demanda.</p></div><div class="divide-y divide-slate-200 border-y border-slate-200">{service.services.map((item,index)=><div class="grid grid-cols-[48px_1fr] items-center gap-4 py-5"><span class="text-xs font-black text-emerald-800">{String(index+1).padStart(2,'0')}</span><strong class="text-lg text-slate-900">{item}</strong></div>)}</div></div></section>
<section class="bg-slate-950 text-white"><div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28"><div class="grid gap-14 lg:grid-cols-[.85fr_1.15fr]"><div><span class="text-xs font-black uppercase tracking-[.18em] text-emerald-400">Identifique sua situação</span><h2 class="mt-4 text-3xl font-black tracking-[-.035em] lg:text-5xl">Este serviço pode ajudar quando...</h2></div><div class="space-y-0 border-t border-white/15">{service.situations.map((item)=><div class="flex gap-4 border-b border-white/15 py-6"><FAIcon name="arrow-right" class="mt-1 h-4 w-4 shrink-0 text-emerald-400" /><p class="m-0 text-lg leading-7 text-slate-200">{item}</p></div>)}</div></div></div></section>
<section class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28"><div class="grid gap-12 lg:grid-cols-2 lg:gap-20"><div><span class="text-xs font-black uppercase tracking-[.18em] text-emerald-800">Possíveis entregas</span><h2 class="mt-4 text-3xl font-black tracking-[-.035em] text-slate-950">O que pode compor o trabalho</h2><ul class="mt-8 divide-y divide-slate-200 border-y border-slate-200">{service.deliverables.map(item=><li class="flex gap-3 py-4 text-slate-700"><FAIcon name="check" class="mt-1 h-3.5 w-3.5 shrink-0 text-emerald-700" /><span>{item}</span></li>)}</ul></div><div><span class="text-xs font-black uppercase tracking-[.18em] text-emerald-800">Documentação inicial</span><h2 class="mt-4 text-3xl font-black tracking-[-.035em] text-slate-950">O que normalmente será solicitado</h2><ul class="mt-8 divide-y divide-slate-200 border-y border-slate-200">{service.documents.map(item=><li class="flex gap-3 py-4 text-slate-700"><FAIcon name="file-lines" class="mt-1 h-3.5 w-3.5 shrink-0 text-emerald-700" /><span>{item}</span></li>)}</ul></div></div></section>
<section class="border-y border-slate-200 bg-slate-50"><div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-24"><div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end"><div><span class="text-xs font-black uppercase tracking-[.18em] text-emerald-800">Fluxo de trabalho</span><h2 class="mt-4 text-3xl font-black tracking-[-.035em] text-slate-950 lg:text-5xl">Do primeiro contato à entrega.</h2></div><a href="/como-trabalhamos" class="inline-flex items-center gap-2 text-sm font-bold text-emerald-800">Entenda nossa metodologia <FAIcon name="arrow-right" class="h-3.5 w-3.5" /></a></div><ol class="mt-12 grid border-t border-slate-300 md:grid-cols-5">{service.stages.map((item,index)=><li class="border-b border-slate-300 py-6 md:border-b-0 md:border-r md:px-5 md:first:pl-0 md:last:border-r-0"><span class="text-xs font-black text-emerald-800">0{index+1}</span><strong class="mt-5 block text-sm leading-6 text-slate-900">{item}</strong></li>)}</ol></div></section>
<section class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28"><div class="grid gap-12 rounded-[2rem] bg-emerald-950 px-7 py-10 text-white sm:px-10 lg:grid-cols-[1fr_auto] lg:items-center lg:px-14 lg:py-14"><div><span class="text-xs font-black uppercase tracking-[.18em] text-emerald-300">Próximo passo</span><h2 class="mt-3 text-3xl font-black tracking-[-.035em] lg:text-4xl">Apresente sua demanda de {service.shortTitle.toLowerCase()}.</h2><p class="mt-4 max-w-3xl leading-7 text-emerald-50/75">Envie as informações iniciais. Antes da contratação, confirmamos escopo, documentos, prazo, valor e responsabilidade técnica.</p></div><a href={`/orcamento?servico=${service.slug}`} class="inline-flex items-center justify-center gap-2 rounded-xl bg-white px-5 py-3.5 text-sm font-bold text-emerald-950">Solicitar análise inicial <FAIcon name="arrow-right" class="h-3.5 w-3.5" /></a></div><div class="mt-8 grid gap-6 border-t border-slate-200 pt-8 lg:grid-cols-[.7fr_1.3fr]"><strong class="text-sm text-slate-900">Observação técnica</strong><p class="m-0 text-sm leading-6 text-slate-500">{service.note}</p></div></section>
</BaseLayout>
